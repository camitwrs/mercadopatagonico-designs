---
import '../styles/base.css';
import { DESIGNS } from '../lib/designs.js';
import Bi from '../components/Bi.astro';

const { n } = Astro.props;
const current = DESIGNS.find((d) => d.n === n);
---
<!doctype html>
<html lang="es" data-lang="es" data-theme="light">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <meta name="description" content="Mercado Patagónico: abastecimiento de alimentos para el canal HORECA de Magallanes." />
    <link rel="icon" type="image/svg+xml" href="/favicon.svg" />
    <title>Diseño {n} · {current.name} — Mercado Patagónico</title>
    <script is:inline>
      (function () {
        var d = document.documentElement;
        d.classList.add('js');
        try {
          var l = localStorage.getItem('mp-lang'), t = localStorage.getItem('mp-theme');
          d.dataset.lang = l === 'en' ? 'en' : 'es';
          d.lang = d.dataset.lang;
          d.dataset.theme = t === 'dark' ? 'dark' : 'light';
        } catch (e) {}
      })();
    </script>
  </head>
  <body>
    <header class="vbar" id="vbar">
      <p class="vtitle">
        <span class="vtitle-d"><Bi f={(X) => X.design} /> {n}</span>
        <span class="vtitle-sep" aria-hidden="true">·</span>
        <span class="vtitle-n">{current.name}</span>
      </p>
      <nav class="vtabs" aria-label="Diseños">
        {DESIGNS.map((d) => (
          <a class="vtab" href={d.href} aria-current={d.n === n ? 'page' : undefined}>
            <b>{d.n}</b><span>{d.name}</span>
          </a>
        ))}
      </nav>
      <div class="vtools">
        <button class="vt vt-lang" type="button" data-lang-toggle aria-label="Idioma / Language">
          <span class="seg" data-seg="es">ES</span><span class="seg" data-seg="en">EN</span>
        </button>
        <button class="vt vt-theme" type="button" data-theme-toggle aria-label="Modo claro / oscuro">
          <span class="seg" data-seg="light">
            <svg viewBox="0 0 24 24" width="15" height="15" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round"><circle cx="12" cy="12" r="4"/><path d="M12 2v2M12 20v2M4.9 4.9l1.4 1.4M17.7 17.7l1.4 1.4M2 12h2M20 12h2M4.9 19.1l1.4-1.4M17.7 6.3l1.4-1.4"/></svg>
            <span class="l-es">Claro</span><span class="l-en">Light</span>
          </span>
          <span class="seg" data-seg="dark">
            <svg viewBox="0 0 24 24" width="15" height="15" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M21 12.8A9 9 0 1 1 11.2 3 7 7 0 0 0 21 12.8z"/></svg>
            <span class="l-es">Oscuro</span><span class="l-en">Dark</span>
          </span>
        </button>
      </div>
    </header>
    <main class="d-root">
      <slot />
    </main>
    <div class="toast" role="status" aria-live="polite" id="toast"></div>
    <script>
      import '../scripts/interact.js';
    </script>
  </body>
</html>
