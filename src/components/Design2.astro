---
// Diseño 2 · Mesa servida: la mesa de un restaurante, la carta del servicio y los pasos como tiempos del menú.
import '@fontsource-variable/manrope';
import Bi from './Bi.astro';
import Nav from './Nav.astro';
import HeroText from './HeroText.astro';
import Garantias from './Garantias.astro';
import QueEs from './QueEs.astro';
import ParaQuien from './ParaQuien.astro';
import Faq from './Faq.astro';
import ContactForm from './ContactForm.astro';
import Footer from './Footer.astro';
import Logo from './Logo.astro';
import I18N from '../data/i18n.json';
import { tableSVG, orn5SVG, cutlerySVG, C5 } from '../lib/svg.js';

const table = tableSVG(580, { plate: 'var(--card)', line: 'currentColor', gold: C5.oro, glass: 'var(--glass)' });
const orn = orn5SVG(C5.oro);
const cutlery = cutlerySVG(170, C5.oro);
---
<div class="d d2">
  <Nav><Logo kind={3} /></Nav>

  <section class="hero wrap d2-hero">
    <HeroText title={(X) => X.h5} />
    <div class="hero-vis" data-zone>
      <div class="tbl" set:html={table} />
      <div class="menu" data-reveal="zoom" style="--i:3">
        <div class="menu-in">
          <h3><Bi f={(X) => X.boardTitle} /></h3>
          <span class="orn" set:html={orn} />
          {I18N.es.boardRows.map((_, i) => (
            <div class="menu-r" style={`--i:${i}`}>
              <b><Bi f={(X) => X.boardRows[i][0]} /></b>
              <span><Bi f={(X) => X.boardRows[i][1]} /></span>
            </div>
          ))}
        </div>
      </div>
    </div>
  </section>

  <div class="gar-w"><Garantias icons /></div>

  <QueEs>
    <div class="cut-w" aria-hidden="true"><div class="cut" set:html={cutlery} /></div>
  </QueEs>

  <section class="how-w" id="como-funciona">
    <div class="how wrap">
      <h2 data-reveal><Bi f={(X) => X.stepsTitle1} /></h2>
      <div class="courses">
        {I18N.es.steps.map((_, i) => (
          <article class="course" data-reveal style={`--i:${i}`} data-live tabindex="0">
            <div class="plate">
              <svg viewBox="0 0 124 124" aria-hidden="true"><circle cx="62" cy="62" r="60" pathLength="1" /></svg>
              <span>{i + 1}</span>
            </div>
            <h3><Bi f={(X) => X.steps[i][0]} /></h3>
            <p><Bi f={(X) => X.steps[i][1]} /></p>
          </article>
        ))}
      </div>
    </div>
  </section>

  <ParaQuien />
  <Faq />

  <section class="cta-w" id="contacto">
    <div class="cta wrap">
      <div class="cta-l">
        <h2 data-reveal><Bi f={(X) => X.ctaTitle1} /></h2>
        <p data-reveal style="--i:1"><Bi f={(X) => X.ctaText} /></p>
      </div>
      <ContactForm />
    </div>
  </section>

  <Footer><Logo kind={3} /></Footer>
</div>

<style is:global>
  .d2 {
    --bg: #F7F4EE; --bg2: #EFE9DE; --emph: #1B1D1F; --fg: #1B1D1F; --mut: #5E6064;
    --btn-bg: #1B1D1F; --btn-fg: #F7F4EE; --accent: #B89B5E; --card: #FFFFFF; --glass: #6B1F2A; --oro: #B89B5E;
    --f-head: 'Manrope Variable', sans-serif; --f-headmd: var(--f-head); --f-body: 'Manrope Variable', sans-serif; --f-bodymd: var(--f-body);
    --r-btn: 2px; --r-chip: 2px; --r-panel: 2px; --r-form: 2px; --r-field: 2px;
    --para-bg: #1B1D1F; --para-fg: #F7F4EE; --para-dot: #B89B5E; --para-btn-bg: #B89B5E; --para-btn-fg: #1B1D1F;
    --form-bg: var(--card); --field-bg: var(--bg); --form-shadow: 0 14px 28px rgba(0,0,0,.12); --f-sub: var(--f-head);
  }
  html[data-theme="dark"] .d2 {
    --bg: #151618; --bg2: #1F2022; --emph: #0D0E0F; --fg: #F7F4EE; --mut: #B5B3AD; --btn-bg: #B89B5E; --btn-fg: #1B1D1F; --card: #26272A;
    --para-bg: #0D0E0F;
  }
  .d2 h1, .d2 h2, .d2 .light { font-weight: 300; }
  .d2 h3, .d2 .btn, .d2 .nav-links a { font-weight: 500; }
  .d2 .hero-title { font-family: var(--f-head); font-weight: 300; font-size: clamp(40px, 5vw, 72px); line-height: 1.08; letter-spacing: -.03em; }
  .d2 .hero-body { font-size: 19px; }
  .d2 .logo-tx { font-weight: 500; font-size: 21px; line-height: 1.12; letter-spacing: -.01em; }
  .d2-hero { padding-block: 56px 72px; }

  /* mesa servida */
  .d2 .hero-vis { position: relative; height: 560px; --mx: 0; --my: 0; perspective: 1100px; }
  .d2 .tbl { position: absolute; left: 0; top: 20px; width: 100%; color: var(--fg); transform: rotateX(calc(var(--my) * -4deg)) rotateY(calc(var(--mx) * 5deg)); transition: transform .35s ease-out; }
  .d2 .tbl svg { width: 100%; height: auto; }
  .d2 .tbl .ring { stroke-dasharray: 868; stroke-dashoffset: 868; animation: d2draw 2.2s .3s ease-out forwards; }
  .d2 .tbl .fork { animation: d2fromL 1s .5s cubic-bezier(.2,.8,.2,1) both; }
  .d2 .tbl .knife { animation: d2fromR 1s .65s cubic-bezier(.2,.8,.2,1) both; }
  .d2 .tbl .spoon { animation: d2fromR 1s .8s cubic-bezier(.2,.8,.2,1) both; }
  .d2 .tbl .glass { animation: d2wine 4s 1.5s ease-in-out infinite; transform-box: fill-box; transform-origin: center; }
  @keyframes d2draw { to { stroke-dashoffset: 0; } }
  @keyframes d2fromL { from { transform: translateX(-60px); opacity: 0; } to { transform: none; opacity: 1; } }
  @keyframes d2fromR { from { transform: translateX(60px); opacity: 0; } to { transform: none; opacity: 1; } }
  @keyframes d2wine { 0%, 100% { transform: scale(1); } 50% { transform: scale(1.14); } }
  .d2 .menu { position: absolute; left: 290px; top: 130px; width: 270px; transform: translate(calc(var(--mx) * -10px), calc(var(--my) * -10px)) rotate(2deg); background: var(--card); padding: 14px; border: 1.5px solid #B89B5E; box-shadow: 0 14px 26px rgba(0,0,0,.2); transition: transform .35s ease-out, box-shadow .35s; z-index: 2; }
  html .d2 .menu.in { transform: translate(calc(var(--mx) * -10px), calc(var(--my) * -10px)) rotate(2deg); }
  .d2 .menu:hover { box-shadow: 0 22px 38px rgba(0,0,0,.28); }
  .d2 .menu-in { border: 1px solid rgba(184,155,94,.55); padding: 26px 22px 28px; display: flex; flex-direction: column; align-items: center; gap: 16px; text-align: center; }
  .d2 .menu-in h3 { font-size: 19px; }
  .d2 .orn svg { transition: transform .6s; }
  .d2 .menu:hover .orn svg { transform: scaleX(1.25); }
  .d2 .menu-r { display: flex; flex-direction: column; gap: 3px; transition: transform .3s; }
  .d2 .menu-r:hover { transform: scale(1.05); }
  .d2 .menu-r b { font-weight: 500; font-size: 15px; }
  .d2 .menu-r span { font-size: 13px; color: var(--mut); }
  @media (max-width: 980px) {
    .d2-hero { padding-block: 24px 36px; }
    .d2 .hero-vis { height: auto; display: flex; flex-direction: column; gap: 28px; perspective: none; }
    .d2 .tbl { position: relative; top: 0; }
    .d2 .menu { position: relative; left: 0; top: 0; width: 100%; transform: none !important; }
  }

  /* garantías */
  .d2 .gar-w { background: var(--bg2); }
  .d2 .gar-ic { background: var(--oro); color: #fff; }
  .d2 .gar-c { position: relative; }
  .d2 .gar-c + .gar-c::before { content: ''; position: absolute; left: -24px; top: 0; bottom: 0; width: 1px; background: color-mix(in srgb, var(--fg) 20%, transparent); }
  .d2 .gar-c h3 { font-size: clamp(22px, 1.8vw, 26px); font-weight: 500; line-height: 1; }
  @media (max-width: 980px) { .d2 .gar-c + .gar-c::before { display: none; } }

  /* qué es */
  .d2 .que h2 { font-size: clamp(36px, 3.9vw, 56px); letter-spacing: -.02em; line-height: .96; }
  .d2 .cut-w { position: absolute; left: calc(max(0px, (100% - 1440px) / 2) + var(--pad) + 10px); bottom: 30px; }
  .d2 .cut { animation: d2float 5s ease-in-out infinite alternate; transform-origin: 50% 100%; transition: transform .5s cubic-bezier(.3,1.5,.5,1); }
  .d2 .cut-w:hover .cut { transform: rotate(-12deg) scale(1.08); animation-play-state: paused; }
  @keyframes d2float { from { transform: translateY(0) rotate(-2deg); } to { transform: translateY(-8px) rotate(2deg); } }
  @media (max-width: 1100px) { .d2 .cut-w { display: none; } }

  /* tiempos del menú */
  .d2 .how-w { background: var(--bg2); }
  .d2 .how { padding-block: 64px; display: flex; flex-direction: column; gap: 40px; }
  .d2 .how h2 { font-size: clamp(36px, 3.9vw, 56px); letter-spacing: -.02em; line-height: 1.08; }
  .d2 .courses { display: grid; grid-template-columns: repeat(4, 1fr); gap: 32px; }
  .d2 .course { display: flex; flex-direction: column; align-items: center; gap: 14px; text-align: center; outline-offset: 6px; }
  .d2 .course h3 { font-size: 22px; line-height: 1.12; }
  .d2 .course p { font-size: 15px; line-height: 1.58; color: var(--mut); }
  .d2 .plate { position: relative; width: 120px; height: 120px; border-radius: 50%; background: var(--card); border: 2px solid var(--oro); box-shadow: 0 6px 14px rgba(0,0,0,.12); display: grid; place-items: center; transition: transform .5s cubic-bezier(.3,1.5,.5,1), box-shadow .4s; }
  .d2 .plate::before { content: ''; position: absolute; inset: 10px; border-radius: 50%; border: 1px solid color-mix(in srgb, var(--fg) 18%, transparent); }
  .d2 .plate svg { position: absolute; inset: -2px; width: calc(100% + 4px); height: calc(100% + 4px); transform: rotate(-90deg); }
  .d2 .plate circle { fill: none; stroke: var(--oro); stroke-width: 3; stroke-dasharray: 1; stroke-dashoffset: 1; stroke-linecap: round; }
  .d2 .course.live .plate circle { animation: d2ring 1.6s calc(.3s + var(--i) * .35s) ease-out forwards; }
  @keyframes d2ring { to { stroke-dashoffset: 0; } }
  .d2 .plate span { font-weight: 300; font-size: 50px; line-height: 1; transition: transform .4s; }
  .d2 .course:hover .plate, .d2 .course:focus .plate { transform: translateY(-8px) scale(1.06); box-shadow: 0 18px 28px rgba(0,0,0,.2); }
  .d2 .course:hover .plate span { transform: scale(1.12); }
  @media (max-width: 1100px) { .d2 .courses { grid-template-columns: 1fr 1fr; } }
  @media (max-width: 700px) {
    .d2 .how { padding-block: 48px; gap: 24px; }
    .d2 .courses { grid-template-columns: 1fr; gap: 24px; }
    .d2 .course { flex-direction: row; flex-wrap: wrap; align-items: center; text-align: left; column-gap: 18px; row-gap: 6px; }
    .d2 .plate { width: 76px; height: 76px; }
    .d2 .plate span { font-size: 32px; }
    .d2 .course h3 { font-size: 19px; flex: 1 1 calc(100% - 100px); align-self: end; }
    .d2 .course p { flex: 1 1 100%; margin-left: 0; font-size: 14px; }
  }

  /* preguntas */
  .d2 .faq-s { background: var(--bg2); }
  .d2 .faq-s > .wrap > h2 { font-size: clamp(36px, 3.9vw, 56px); letter-spacing: -.02em; line-height: 1.05; }
  .d2 .faq-item { border-top: 2px solid var(--fg); padding-top: 14px; }
  .d2 .faq-t { font-weight: 500; font-size: clamp(19px, 1.53vw, 22px); }
  .d2 .faq-q:hover .faq-ic { background: var(--oro); border-color: var(--oro); color: #fff; }

  /* contacto */
  .d2 .cta-l h2 { font-size: clamp(42px, 5.56vw, 80px); line-height: 1.06; letter-spacing: -.03em; }
  .d2 .form h3 { font-size: 30px; font-weight: 500; }
  .d2 .foot-w { background: var(--emph); color: #F7F4EE; }
</style>
